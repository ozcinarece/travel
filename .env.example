# Kopyala: .env.local (git'e girmez). EXPO_PUBLIC_ ile başlayanlar istemci paketine girer.

# Supabase (Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps — istemci anahtarları uygulama kimliğine / referrer'a kısıtlı olmalı.
# Places ve Routes anahtarı yalnızca Supabase Edge Function secret'ında durur, burada değil.
GOOGLE_MAPS_IOS_KEY=
GOOGLE_MAPS_ANDROID_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_WEB_KEY=
# Autocomplete istemciden çağrılır (teknik not §3); ayrı, kısıtlı anahtar.
EXPO_PUBLIC_GOOGLE_PLACES_AUTOCOMPLETE_KEY=

# Davet linki alan adı: https://{APP_DOMAIN}/r/{token}
APP_DOMAIN=
IOS_BUNDLE_ID=
ANDROID_PACKAGE=
